---
interface Props { title: string; description: string; path?: string; lang?: "es" | "en"; }
const { title, description, path = "/", lang = "es" } = Astro.props;
const canonical = Astro.site ? new URL(path, Astro.site).href : undefined;
const root = Astro.site ?? new URL("https://paseocosta.com/");
const topic = path.replace(/^\/en(?=\/|$)/, "") || "/";
const esHref = new URL(topic, root).href;
const enHref = new URL(topic === "/" ? "/en/" : `/en${topic}`, root).href;
const imagePath = "/images/social.png";
const image = Astro.site ? new URL(imagePath, Astro.site).href : undefined;
const imageAlt = lang === "es" ? "Ilustración conceptual del río para la guía de Paseo de la Costa" : "Conceptual river illustration for the Paseo de la Costa guide";
---
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="theme-color" content="#075B73" />
<meta name="description" content={description} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" sizes="any" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" sizes="16x16" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" sizes="32x32" />
<link rel="apple-touch-icon" href="/favicon.svg" sizes="180x180" />
<link rel="manifest" href="/manifest.webmanifest" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600;6..72,700&display=swap" rel="stylesheet" />
{canonical && <link rel="canonical" href={canonical} />}
<link rel="alternate" hreflang="es" href={esHref} />
<link rel="alternate" hreflang="en" href={enHref} />
<link rel="alternate" hreflang="x-default" href={esHref} />
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{canonical && <meta property="og:url" content={canonical} />}
{image && <meta property="og:image" content={image} />}
{image && <meta property="og:image:alt" content={imageAlt} />}
<meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
<script is:inline src="/analytics.js"></script>
<title>{title}</title>
