---
import type { Language } from "./SiteShell";

interface Props {
  lang: Language;
}
const { lang } = Astro.props;

const T = lang === "es"
  ? {
      marker: "Por estación",
      eyebrow: "Estrategia de visita según el año",
      title: "Cuándo ir: clima, río y vida silvestre",
      intro:
        "Neuquén se encuentra en el norte de la Patagonia. La tabla resume el promedio climático regional típico; el pronóstico real del día lo da el módulo de clima más abajo.",
      caption: "Promedios climáticos regionales de Neuquén (climatología típica del norte de Patagonia).",
      cols: ["Estación", "Clima y temperaturas", "Río y agua", "Vida silvestre", "Recorrido recomendado"],
      rows: [
        ["Primavera · sep–nov", "Templado y variable, vientos cambiantes.", "El nivel sube por el deshielo de la cordillera.", "Aves activas; la vegetación florece.", "Luz suave, buena para caminar con calma."],
        ["Verano · dic–feb", "Cálido, sol fuerte, tormentas por la tarde.", "Río crecido y correntoso; mucha exposición.", "Familias de aves costeras; poca sombra.", "Salí temprano o al final del día; hidratate."],
        ["Otoño · mar–may", "Templado y estable, luz dorada.", "Nivel moderado, aguas más tranquilas.", "Buen momento para avistaje y fotografía.", "Paseos largos muy cómodos."],
        ["Invierno · jun–ago", "Frío, heladas, días cortos.", "Agua fría; superficie más calma.", "Menos actividad; ambiente sereno.", "Abrigate y aprovechá las horas centrales."],
      ],
    }
  : {
      marker: "By season",
      eyebrow: "Visit strategy through the year",
      title: "When to go: weather, river and wildlife",
      intro:
        "Neuquén lies in northern Patagonia. The table summarises the typical regional climate average; the real daily forecast is in the weather module below.",
      caption: "Regional climate averages for Neuquén (typical northern Patagonia climatology).",
      cols: ["Season", "Weather and temperatures", "River and water", "Wildlife", "Recommended walk"],
      rows: [
        ["Spring · Sep–Nov", "Mild and variable, shifting winds.", "Level rises with snowmelt from the mountains.", "Active birds; vegetation in bloom.", "Soft light, good for a relaxed walk."],
        ["Summer · Dec–Feb", "Warm, strong sun, afternoon storms.", "High, fast-flowing river; high exposure.", "Coastal bird families; little shade.", "Go early or late in the day; hydrate."],
        ["Autumn · Mar–May", "Mild and stable, golden light.", "Moderate level, calmer water.", "Good for wildlife watching and photos.", "Very comfortable for long walks."],
        ["Winter · Jun–Aug", "Cold, frosts, short days.", "Cold water; calmer surface.", "Less activity; serene mood.", "Dress warm and use the midday hours."],
      ],
    };
---
<section class="seasonal-section section-flow" id="estaciones" aria-labelledby="seasonal-heading">
  <div class="section-marker"><span>09</span><i>{T.marker}</i></div>
  <p class="eyebrow">{T.eyebrow}</p>
  <h2 id="seasonal-heading">{T.title}</h2>
  <p class="section-lede">{T.intro}</p>
  <div class="table-wrap">
    <table class="season-table">
      <caption>{T.caption}</caption>
      <thead>
        <tr>{T.cols.map((c) => <th scope="col">{c}</th>)}</tr>
      </thead>
      <tbody>
        {T.rows.map((row) => (
          <tr>
            {row.map((cell, i) => (i === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>
