---
import type { Language } from "./SiteShell";

interface Props {
  lang: Language;
}
const { lang } = Astro.props;

const T = lang === "es"
  ? {
      marker: "Por estación",
      eyebrow: "Estrategia de visita según el año",
      title: "Cuándo ir: clima, río y vida silvestre",
      intro:
        "Neuquén se encuentra en el norte de la Patagonia. La tabla propone formas de planificar, no promedios medidos ni un pronóstico del nivel del río. Consultá el pronóstico y las condiciones del sector antes de salir.",
      caption: "Ideas de planificación por estación; condiciones a confirmar.",
      cols: ["Estación", "Clima y temperaturas", "Río y agua", "Vida silvestre", "Recorrido recomendado"],
      rows: [
        ["Primavera · sep–nov", "Templado y variable, vientos cambiantes.", "El nivel y la corriente deben verificarse en el día.", "Aves activas; la vegetación florece.", "Luz suave, buena para caminar con calma."],
        ["Verano · dic–feb", "Planificá protección solar y revisá tormentas.", "No asumir habilitación para baño.", "Familias de aves costeras; poca sombra.", "Salí temprano o al final del día; hidratate."],
        ["Otoño · mar–may", "Revisá temperatura y viento antes de salir.", "No inferir aguas tranquilas por la estación.", "Buen momento para avistaje y fotografía.", "Elegí la duración según el pronóstico."],
        ["Invierno · jun–ago", "Frío, heladas, días cortos.", "La calma superficial no indica seguridad.", "Menos actividad; ambiente sereno.", "Abrigate y aprovechá las horas centrales."],
      ],
    }
  : {
      marker: "By season",
      eyebrow: "Visit strategy through the year",
      title: "When to go: weather, river and wildlife",
      intro:
        "Neuquén lies in northern Patagonia. The table offers planning ideas, not measured climate averages or river-level forecasts. Check the forecast and local conditions before leaving.",
      caption: "Seasonal planning ideas; confirm actual conditions.",
      cols: ["Season", "Weather and temperatures", "River and water", "Wildlife", "Recommended walk"],
      rows: [
        ["Spring · Sep–Nov", "Mild and variable, shifting winds.", "Check the actual level and current.", "Active birds; vegetation in bloom.", "Soft light, good for a relaxed walk."],
        ["Summer · Dec–Feb", "Plan sun protection and check for storms.", "Do not assume swimming is permitted.", "Coastal bird families; little shade.", "Go early or late in the day; hydrate."],
        ["Autumn · Mar–May", "Check temperature and wind before leaving.", "Do not infer calm water from the season.", "Good for wildlife watching and photos.", "Choose duration according to the forecast."],
        ["Winter · Jun–Aug", "Cold, frosts, short days.", "A calm surface does not establish safety.", "Less activity; serene mood.", "Dress warm and use the midday hours."],
      ],
    };
---
<section class="seasonal-section section-flow" id="estaciones" aria-labelledby="seasonal-heading">
  <div class="section-marker"><span>09</span><i>{T.marker}</i></div>
  <p class="eyebrow">{T.eyebrow}</p>
  <h2 id="seasonal-heading">{T.title}</h2>
  <p class="section-lede">{T.intro}</p>
  <div class="table-wrap">
    <table class="season-table">
      <caption>{T.caption}</caption>
      <thead>
        <tr>{T.cols.map((c) => <th scope="col">{c}</th>)}</tr>
      </thead>
      <tbody>
        {T.rows.map((row) => (
          <tr>
            {row.map((cell, i) => (i === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>
