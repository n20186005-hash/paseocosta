---
import BaseHead from "../components/BaseHead.astro";
import "../styles/global.css";
interface Props { title: string; description: string; path?: string; lang?: string; }
const { title, description, path, lang = "es-AR" } = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head><BaseHead title={title} description={description} path={path} lang={lang === "en" ? "en" : "es"} /></head>
  <body>
    <slot />
    <script is:inline>
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js").catch(() => {});
        });
      }
    </script>
  </body>
</html>
