---
import BaseLayout from "../layouts/BaseLayout.astro";
import Home from "../components/Home";
import WeatherSection from "../components/WeatherSection.astro";
import ServicesSection from "../components/ServicesSection.astro";
import TransportSection from "../components/TransportSection.astro";
import SeasonalSection from "../components/SeasonalSection.astro";
import RoutesSection from "../components/RoutesSection.astro";
import ScienceSection from "../components/ScienceSection.astro";
import { buildAttractionSchema, buildFaqSchema, seoTitle, seoDescription } from "../lib/schema";

const lang = "es";
const attractionSchema = buildAttractionSchema(lang);
const faqSchema = buildFaqSchema(lang);
---
<BaseLayout title={seoTitle(lang)} description={seoDescription(lang)} path="/">
  <script is:inline type="application/ld+json" set:html={JSON.stringify(attractionSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <Home initialLanguage="es" />
  <WeatherSection lang="es" />
  <ServicesSection lang="es" />
  <TransportSection lang="es" />
  <SeasonalSection lang="es" />
  <RoutesSection lang="es" />
  <ScienceSection lang="es" />
</BaseLayout>
